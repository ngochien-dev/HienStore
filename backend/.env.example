# ==========================================
# ENV TEMPLATE FOR PRODUCTION (Render.com)
# ==========================================

# Database (Aiven.io)
DB_HOST=mysql-xxxx.aivencloud.com
DB_PORT=19213
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password

# Redis (Render.com or Upstash)
REDIS_HOST=redis-xxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Email configuration
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# App settings
APP_PORT=8080

# JWT Secrets
JWT_PRIVATE_KEY=your_base64_private_key
JWT_PUBLIC_KEY=your_base64_public_key
JWT_EXPIRATION=86400000

# VNPay
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://hien-store.vercel.app/payment-return

# Gemini API
GEMINI_API_KEY=your_gemini_api_key
