# =====================================================
# HienStore - Environment Variables
# =====================================================
# Copy this file to .env and fill in the values

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hienstore
DB_USERNAME=root
DB_PASSWORD=root

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Server ---
APP_PORT=8080

# --- JWT (generate RSA keys for production) ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRATION=86400000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- VNPay Sandbox ---
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment-return
VNP_TMN_CODE=
VNP_HASH_SECRET=

# --- Mail (Gmail App Password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- AI / Gemini ---
GEMINI_API_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:8080
